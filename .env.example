# Copy this file to .env.local and fill in real values.
# .env.local is git-ignored — never commit real secrets (SR-1).

# --- Database (server-only) ---
# Vercel Postgres / Neon connection string.
DATABASE_URL="postgres://user:password@host:5432/dbname"

# --- Auth.js (server-only) ---
# Generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET="replace-with-a-long-random-value"

# Public base URL of the deployed app (used for auth callback + email links).
AUTH_URL="http://localhost:3000"

# --- Email magic-link sign-in (primary provider) ---
# SMTP connection string, e.g. smtp://user:pass@smtp.example.com:587
# (works with Gmail SMTP, SendGrid SMTP, Mailtrap for local dev, etc.)
EMAIL_SERVER="smtp://user:pass@smtp.example.com:587"
EMAIL_FROM="Home Education Log <no-reply@example.com>"

# --- GitHub OAuth (optional secondary sign-in provider) ---
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""
