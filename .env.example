# Copy this file to .env.local and fill in real values.
# .env.local is git-ignored — never commit real secrets (SR-1).

# --- Database (server-only) ---
# Vercel Postgres / Neon connection string.
DATABASE_URL="postgres://user:password@host:5432/dbname"

# --- Auth.js (server-only) ---
# Generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET="replace-with-a-long-random-value"

# OAuth provider (GitHub) — server-only secret.
AUTH_GITHUB_ID="replace-with-github-oauth-client-id"
AUTH_GITHUB_SECRET="replace-with-github-oauth-client-secret"

# Public base URL of the deployed app (used for auth callback + deep links).
AUTH_URL="http://localhost:3000"

# --- Web Push / VAPID ---
# Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY="replace-with-vapid-public-key"
VAPID_PRIVATE_KEY="replace-with-vapid-private-key"
VAPID_SUBJECT="mailto:you@example.com"

# Public key must also be exposed to the client to subscribe (not a secret).
NEXT_PUBLIC_VAPID_PUBLIC_KEY="replace-with-vapid-public-key"

# --- Cron ---
# Long random bearer token Vercel Cron sends as Authorization: Bearer <value>.
CRON_SECRET="replace-with-a-long-random-value"
